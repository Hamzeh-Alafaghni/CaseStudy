------------prompt-------------
Can you give me a very simple example about composite ?
------------AI Response-------------
import java.util.ArrayList;
import java.util.List;

// 1. THE COMPONENT
interface Worker {
    void showDetails();
}

// 2. THE LEAF (Individual worker)
class Developer implements Worker {
    private String name;

    public Developer(String name) { this.name = name; }

    public void showDetails() {
        System.out.println("Developer: " + name);
    }
}

// 3. THE COMPOSITE (Manager / Group)
class Manager implements Worker {
    private String name;
    private List<Worker> team = new ArrayList<>();

    public Manager(String name) { this.name = name; }

    public void add(Worker w) { team.add(w); }

    public void showDetails() {
        System.out.println("Manager: " + name);
        for (Worker w : team) {
            w.showDetails(); // Cascades down automatically
        }
    }
}

// 4. TEST
public class TestComposite {
    public static void main(String[] args) {
        Worker dev1 = new Developer("Alice");
        Worker dev2 = new Developer("Bob");

        Manager empGroup = new Manager("Charlie (Lead)");
        empGroup.add(dev1);
        empGroup.add(dev2);

        // Treat the individual or the group with the exact same method call!
        empGroup.showDetails();
    }
}

